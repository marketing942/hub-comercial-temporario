# --- Supabase ---
# Pegue estes valores em: Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# --- Auth (chaves de acesso) ---
# Senha unica do administrador
ADMIN_PASSWORD=defina-uma-senha-forte-do-admin
# Senha unica compartilhada por todos os vendedores
SELLER_PASSWORD=defina-uma-senha-forte-do-vendedor

# Segredo para assinar cookies. OBRIGATORIO em producao (>= 32 chars).
# Gere com: openssl rand -base64 48
SESSION_SECRET=gere-uma-string-aleatoria-com-no-minimo-32-caracteres
